{
  "name": "frostecho",
  "version": "0.1.0",
  "private": true,
  "description": "FrostEcho: G00 world kernel and G01 observe-decide loop with an HTTP live entry",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
